# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored - never commit real keys.

# App
APP_ENV=development
LOG_LEVEL=INFO

# LLM via OpenRouter (used from Phase 2)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-5.5

# Optional pricing for LLM cost tracking (USD per 1M tokens)
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=

# Persistent PostgreSQL audit storage (Phase 10)
# Leave blank for local development if no PostgreSQL database is configured.
DATABASE_URL=

# Agent safety limits
AGENT_MAX_ITERATIONS=10